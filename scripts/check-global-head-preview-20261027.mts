import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';import {createHash} from 'node:crypto';
const base='https://admin.tail024813.ts.net/game/site/media/weapon-proof-v2/rig-v3/',local=JSON.parse(readFileSync('UnityGame/Assets/Aether/Resources/PlayerRigV3/catalog.json','utf8'));
const catalog=await(await fetch(base+'catalog.json?check='+Date.now(),{cache:'no-store'})).json();assert.deepEqual(catalog,local);assert.equal(catalog.headStandard.id,'aether-head-96-v1');assert.ok(catalog.heads.every((h:any)=>h.w===96&&h.h===96&&!('dy'in h)&&!('dx'in h)&&!('scale'in h)));
const remote=Buffer.from(await(await fetch(base+'head-atlas.png?check='+Date.now(),{cache:'no-store'})).arrayBuffer());assert.equal(createHash('sha256').update(remote).digest('hex'),local.headAtlasSha256);
const html=await(await fetch(base+'index.html?check='+Date.now(),{cache:'no-store'})).text();assert.ok(html.includes('aether-head-96-v1'));assert.ok(!html.includes('h.dy'));assert.ok(html.includes('h.w*scale,h.h*scale'));
for(const action of ['idle','walk','attack']){const r=await fetch(base+'all30-'+action+'-3x.png?check='+Date.now());assert.equal(r.status,200);const actual=Buffer.from(await r.arrayBuffer()),expected=readFileSync('.aether-stage/player-rig-v3/clean/all30-'+action+'-3x.png');assert.deepEqual(actual,expected);}
const result={checkedAt:new Date().toISOString(),status:'PASS',standard:catalog.headStandard.id,heads:30,globalRuntimeAnchor:true,perHeadOffset:false,perHeadScale:false,exactHeadAtlas:true,all30Reviews:['idle','walk','attack'],url:base+'index.html'};writeFileSync('.aether-stage/player-rig-v3/clean/global-head-live-check.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));
