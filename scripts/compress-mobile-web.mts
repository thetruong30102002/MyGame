/** Brotli cho gói Unity web, không đổi ảnh/wasm đã biên dịch. Giữ gzip nguồn để đối chiếu. */
import{createReadStream,createWriteStream,readFileSync,writeFileSync,readdirSync,statSync}from'node:fs';import{join,resolve}from'node:path';import{pipeline}from'node:stream/promises';import{Transform}from'node:stream';import{createGunzip,createBrotliCompress,constants}from'node:zlib';
const dir=resolve(process.argv[2]||'.havenlord-stage/web-pixellab-release/mobile'),folder=join(dir,'Build'),sizes:Record<string,number>={};let before=0,after=0;
for(const f of readdirSync(folder).filter(f=>f.endsWith('.gz'))){const path=join(folder,f),name=f.slice(0,-3)+'.br';let decoded=0;await pipeline(createReadStream(path),createGunzip(),new Transform({transform(chunk,encoding,cb){decoded+=chunk.length;cb(null,chunk);}}),createBrotliCompress({params:{[constants.BROTLI_PARAM_QUALITY]:11,[constants.BROTLI_PARAM_LGWIN]:22}}),createWriteStream(join(folder,name)));sizes['Build/'+name]=decoded;before+=statSync(path).size;after+=statSync(join(folder,name)).size;console.log(f+': '+Math.round(statSync(path).size/1048576)+' MB gzip → '+Math.round(statSync(join(folder,name)).size/1048576)+' MB Brotli');}
let html=readFileSync(join(dir,'index.html'),'utf8');html=html.replaceAll('.data.gz','.data.br').replaceAll('.wasm.gz','.wasm.br').replaceAll('.framework.js.gz','.framework.js.br');writeFileSync(join(dir,'index.html'),html);writeFileSync(join(dir,'decoded-sizes.json'),JSON.stringify(sizes));writeFileSync(join(dir,'compression-check.json'),JSON.stringify({beforeBytes:before,afterBytes:after,ratio:after/before,brotliQuality:11,lossless:true},null,2));console.log(JSON.stringify({gzipMB:Math.round(before/1048576),brotliMB:Math.round(after/1048576),lossless:true}));
