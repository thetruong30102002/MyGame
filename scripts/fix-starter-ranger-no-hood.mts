import{readFileSync,writeFileSync,mkdirSync,existsSync}from'node:fs';import{join}from'node:path';import{loadEnv}from'../packages/asset-pipeline/src/env.js';import{PixelLabMcp}from'../packages/asset-pipeline/src/pixellab/mcp.js';import{waitImages}from'../packages/asset-pipeline/src/pixellab/jobs.js';import{writePng}from'../packages/asset-pipeline/src/image/rgba.js';
const base='packages/asset-pipeline/sources/layered-character/starter-redesign-20261103/roster-standing-v1',m=new PixelLabMcp(loadEnv(process.cwd()).PIXELLAB_TOKENS!.split(',')[0]!.trim()),jobs:any[]=[];
for(const[si,sex]of ['male','female'].entries()){
 const dir=join(base,'bow-'+sex,'no-hood-v2');mkdirSync(dir,{recursive:true});const ref=`packages/asset-pipeline/sources/pixellab/npc_silver_youth${sex==='female'?'_f':''}/Idle/rotations/south.png`;
 const description='Change clothes ONLY: moss-green fitted jacket, brown leather chest harness, belt pouches, dark olive full trousers, long sleeves touching brown gloves, leather boots. Small shoulder mantle BELOW neck only, NO HOOD or hat. Preserve exact UNCOVERED white hair, head, face, height, neck position, feet, pose and original pixel clusters. Slightly fuller athletic body, not bulky. Clear cloth/leather shading. No exposed arm or leg skin. No weapons. Nothing above shoulders changes.';
 if(description.length>500)throw Error('Prompt dài');const args={description,image_base64:readFileSync(ref).toString('base64'),width:80,height:80,no_background:true,seed:73230+si};writeFileSync(join(dir,'request.json'),JSON.stringify({...args,image_base64:'<'+ref+'>',artApproved:false},null,2));
 let jobId:string;if(existsSync(join(dir,'receipt.json')))jobId=JSON.parse(readFileSync(join(dir,'receipt.json'),'utf8')).jobId;else{const receipt=await m.call('edit_image_pixen',args),id=receipt.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/)?.[0];if(!id)throw Error(receipt);jobId=id;writeFileSync(join(dir,'receipt.json'),JSON.stringify({jobId,receipt},null,2));console.log('QUEUED no-hood '+sex+' '+jobId);}jobs.push({dir,jobId,sex});
}
await Promise.all(jobs.map(async j=>{if(!existsSync(join(j.dir,'complete.json'))){const[im]=await waitImages(m,j.jobId,1,{w:80,h:80});writePng(join(j.dir,'S.png'),im!);writeFileSync(join(j.dir,'complete.json'),JSON.stringify({jobId:j.jobId},null,2));}console.log('COMPLETE no-hood '+j.sex);}));
