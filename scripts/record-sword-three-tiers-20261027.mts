import {readFileSync,writeFileSync} from 'node:fs';
const file='docs/ke-hoach-nang-cap-the-gioi.md';let md=readFileSync(file,'utf8');const block=md.match(/<!-- aether-plan:start -->\s*```json\s*([\s\S]*?)\s*```\s*<!-- aether-plan:end -->/)!;const plan=JSON.parse(block[1]!);
const note=' ƯU TIÊN KIẾM SĨ27/10:3 bộ và3 thanh kiếm theo mốc tân thủ/lv5/lv10. Bộ1+kiếm1 tặng lúc chọn class. Bộ2/kiếm2 mặc/cầm từlv5; bộ3/kiếm3 từlv10; nguồn nhận và giá hai cấp sau chưa chốt. Cả3 có dáng nam/nữ, nữ nhỏ nhắn thanh vai/tay/chân hơn, giữ chuẩn đầu/neo cổ. Đủ đứng,đi8,chạy8,chém15 frame ở8 hướng. Vũ khí tách riêng, thay độc lập với đồ. Thiết kế phải khác CẤU TRÚC/SILHOUETTE, cấm chỉ đổi màu: tân thủ áo vải/giáp nhẹ giản dị;lv5 áo da vạt quấn chéo,dây đeo chéo ngực,một giáp vai bất đối xứng,ủng gia cố;lv10 giáp ngực ghép mảnh,giáp tay/chân,áo choàng lưng ngắn/tabard.3 kiếm khác lưỡi/hộ thủ/đốc: kiếm sắt thẳng cơ bản,kiếm cong nhẹ/hộ thủ bảo vệ lv5,kiếm lưỡi lá/hộ thủ cánh gọn lv10; cùng chuẩn chuôi/điểm nắm. Nguồn đổi màu v1 lv5/lv10 đã loại, đang vẽ lại phom riêng. Chi tiết máy đọc: player-rig-v4/tiers.json. BỎ cởi đồ/đồ lót theo chốt mới nhất, không vẽ tiếp nhánh đã hủy. Đang phát triển, chưa nghiệm thu mỹ thuật/đủ động tác nên không tăng%.';
for(const id of ['character-gender-motion-rig-v2','characters-modular-multiweapon','weapon-hand-and-layer-proof']){const t=plan.tasks.find((t:{id:string})=>t.id===id);if(!t.detail.includes('ƯU TIÊN KIẾM SĨ27/10:'))t.detail+=note;}
md=md.replace(block[1]!,JSON.stringify(plan,null,2));writeFileSync(file,md,'utf8');
const docs='docs/thiet-ke/than-nen-va-do-kiem-si-8-huong.md';writeFileSync(docs,'> **Ưu tiên mới nhất:** kiếm sĩ3 bộ/3 kiếm: tặng ban đầu,lv5,lv10. Thay phom/cấu trúc từng cấp, không chỉ đổi màu; mỗi bộ có nam/nữ, nữ nhỏ nhắn, đi/chạy/chém8 hướng, kiếm tách riêng. Cấu hình: `player-rig-v4/tiers.json`. Bỏ toàn bộ nhánh đồ lót bên dưới.\n\n'+readFileSync(docs,'utf8'),'utf8');console.log('Ghi3 bậc kiếm sĩ và yêu cầu thay phom, chưa tăng nghiệm thu.');
