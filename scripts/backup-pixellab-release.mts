import{DatabaseSync,backup}from'node:sqlite';import{mkdirSync,writeFileSync}from'node:fs';
const dir='.havenlord-stage/release-backups';mkdirSync(dir,{recursive:true});const db=new DatabaseSync('apps/server/data/havenlord.db',{readOnly:true}),path=dir+'/before-pixellab-male-'+Date.now()+'.db';const counts={accounts:db.prepare('SELECT count(*) n FROM accounts').get()!.n,characters:db.prepare('SELECT count(*) n FROM characters').get()!.n};await backup(db,path);db.close();writeFileSync(dir+'/pixellab-release.json',JSON.stringify({path,counts,reset:false},null,2));console.log(JSON.stringify({backup:path,counts,reset:false}));
