const planFile='docs/ke-hoach-nang-cap-the-gioi.md';let md=readFileSync(planFile,'utf8');const m=md.match(/<!-- aether-plan:start -->\s*```json\s*([\s\S]*?)\s*```\s*<!-- aether-plan:end -->/);if(!m)throw Error('Thiếu plan');const p=JSON.parse(m[1]!);
