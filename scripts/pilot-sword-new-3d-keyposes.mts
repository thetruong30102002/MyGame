/** Ba tư thế mới, IK 3D giữ độ dài xương; không gọi buildSlash. Chưa tạo clip/game. */
import{readFileSync,writeFileSync,mkdirSync,existsSync}from'node:fs';import{join}from'node:path';
import{loadEnv}from'../packages/asset-pipeline/src/env.js';import{PixelLabMcp}from'../packages/asset-pipeline/src/pixellab/mcp.js';import{waitImages}from'../packages/asset-pipeline/src/pixellab/jobs.js';import{writePng}from'../packages/asset-pipeline/src/image/rgba.js';
type V=[number,number,number];const add=(a:V,b:V):V=>a.map((v,i)=>v+b[i]!)as V,sub=(a:V,b:V):V=>a.map((v,i)=>v-b[i]!)as V,mul=(a:V,s:number):V=>a.map(v=>v*s)as V,dot=(a:V,b:V)=>a.reduce((s,v,i)=>s+v*b[i]!,0),norm=(a:V)=>Math.hypot(...a),unit=(a:V)=>mul(a,1/norm(a));
function ik(a:V,b:V,l1:number,l2:number,pole:V){const d=norm(sub(b,a));if(d>=l1+l2||d<=Math.abs(l1-l2))throw Error('Đích ngoài tầm xương: '+d);const u=unit(sub(b,a)),v=unit(sub(pole,mul(u,dot(pole,u)))),along=(l1*l1-l2*l2+d*d)/(2*d),height=Math.sqrt(l1*l1-along*along),joint=add(a,add(mul(u,along),mul(v,height)));return joint;}
const out='packages/asset-pipeline/sources/layered-character/mau-1/sword-new-3d-keyposes-20261103',base='packages/asset-pipeline/sources/layered-character/mau-1';mkdirSync(out,{recursive:true});
const rest=JSON.parse(readFileSync(join(base,'skeleton/rest-Q0-outfit-bald-N-5732.json'),'utf8')),ref='Q0-outfit-bald-N/seed-5732.png';
const project=(p:V)=>[62.5764+p[0],111.67-p[2]-.35*p[1]];
const specs=[{name:'windup',yaw:-18,drop:1,forward:0,lean:1,hand:[18,-2,14],step:0},{name:'strike',yaw:8,drop:2,forward:2,lean:3,hand:[10,21,-3],step:6},{name:'follow-through',yaw:18,drop:2,forward:3,lean:3,hand:[-5,15,-13],step:8}];
const frames=specs.map(s=>{const yaw=s.yaw*Math.PI/180,hip:V=[0,s.forward,38-s.drop],neck:V=add(hip,[0,s.lean,Math.sqrt(28.14**2-s.lean**2)]),side=(x:number):V=>[x*Math.cos(yaw),x*Math.sin(yaw),0],rs=add(neck,side(11.92)),ls=add(neck,side(-11.92)),rh=add(hip,side(6.8)),lh=add(hip,side(-6.8)),rw=add(neck,s.hand as V),lw=add(hip,[-16,0,4]),ra:V=[8,s.step,0],la:V=[-8,-1,0],re=ik(rs,rw,14.55,12.17,[1,-.25,0]),le=ik(ls,lw,14.55,12.17,[-1,-.25,0]),rk=ik(rh,ra,21.6,16.5,[0,1,0]),lk=ik(lh,la,21.6,16.5,[0,1,0]);
const joints:Record<string,V>={'NECK':neck,'RIGHT SHOULDER':rs,'LEFT SHOULDER':ls,'RIGHT ELBOW':re,'LEFT ELBOW':le,'RIGHT ARM':rw,'LEFT ARM':lw,'RIGHT HIP':rh,'LEFT HIP':lh,'RIGHT KNEE':rk,'LEFT KNEE':lk,'RIGHT LEG':ra,'LEFT LEG':la};
const np=project(neck),keypoints=rest.keypoints.map((k:any)=>{const p=joints[k.label],q=p?project(p):[k.x*128+np[0]-62.5764,k.y*128+np[1]-45.5303],depth=p?Math.round(128-p[1]*2):125;return{label:k.label,x:q[0]!/128,y:q[1]!/128,z_index:depth,depth};});
const grip=project(rw),forearm=project(re),bladeDeg=Math.atan2(-(grip[1]!-forearm[1]!),grip[0]!-forearm[0]!)*180/Math.PI;
return{name:s.name,keypoints,joints,grip,bladeDeg,behind:rw[1]>5,bones:{upperArm:norm(sub(re,rs)),forearm:norm(sub(rw,re)),thigh:norm(sub(rk,rh)),shin:norm(sub(ra,rk))}};});
writeFileSync(join(out,'poses.json'),JSON.stringify({method:'new 3D pose + two-bone IK, no old slash rig',reference:ref,frames},null,2));
const args={description:'Slim bald young man, fitted brown leather vest, ivory long sleeves, brown gloves, narrow brown trousers and boots. Empty closed fists. Same crisp pixel art, anatomy and short neck as reference.',action:'one-handed diagonal cut key poses',direction:'north',view:'low top-down',no_background:true,seed:73151,first_frame_base64:readFileSync(join(base,'raw',ref)).toString('base64'),first_frame_keypoints:rest.keypoints,keypoints:frames.map(f=>f.keypoints)};
writeFileSync(join(out,'request.json'),JSON.stringify({...args,first_frame_base64:'<'+ref+'>',previewOnly:true,buildAllowed:false},null,2));
const m=new PixelLabMcp(loadEnv(process.cwd()).PIXELLAB_TOKENS!.split(',')[0]!.trim());let jobId:string;
if(existsSync(join(out,'receipt.json')))jobId=JSON.parse(readFileSync(join(out,'receipt.json'),'utf8')).jobId;else{const receipt=await m.call('animate_with_skeleton_v3',args),id=receipt.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/)?.[0];if(!id)throw Error(receipt);jobId=id;writeFileSync(join(out,'receipt.json'),JSON.stringify({jobId,receipt},null,2));console.log('QUEUED '+jobId+'; only 3 NEW key poses');}
if(!existsSync(join(out,'complete.json'))){const ims=await waitImages(m,jobId,3,{w:128,h:128});ims.forEach((im,i)=>writePng(join(out,`frame-0${i}.png`),im));writeFileSync(join(out,'complete.json'),JSON.stringify({jobId,frames:3},null,2));}console.log('COMPLETE three key poses, not full animation.');

