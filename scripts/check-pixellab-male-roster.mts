import assert from'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{createHash,randomUUID}from'node:crypto';import{PIXELLAB_MALE_MODELS,playerModel}from'../packages/protocol/src/roster.ts';import{Store}from'../apps/server/src/db.ts';import{newProgress}from'../apps/server/src/http.ts';
import{readPng,createImage,crop,blit}from'../packages/asset-pipeline/src/image/rgba.js';
const base='assets/player-roster/pixellab-male-v1',catalog=JSON.parse(readFileSync(base+'/catalog.json','utf8')).characters,proof=JSON.parse(readFileSync(base+'/provenance.json','utf8'));assert.equal(catalog.length,25);assert.equal(proof.gptArt,false);assert.equal(PIXELLAB_MALE_MODELS.length,25);
const store=new Store(':memory:');const account=store.createAccount('pixellab-test','test-only-hash');assert(account);
let frameRefs=0;for(const m of catalog){assert.equal(m.gender,'male');assert.equal(playerModel(m.id)?.classId,m.classId);const p=proof.models.find((p:any)=>p.id===m.id),png=readFileSync('assets/characters/'+m.id+'/'+m.id+'.png');assert.equal(createHash('sha256').update(png).digest('hex'),p.atlasSha256);const atlas=JSON.parse(readFileSync('assets/characters/'+m.id+'/'+m.id+'.json','utf8')),action=m.classId==='sword'?'attack':m.classId==='staff'?'cast':m.classId==='spear'?'thrust':m.classId==='bow'?'shoot':'bash';for(const d of['S','E','N','W'])for(const a of['idle','walk','run',action]){assert(atlas.animations[a+'_'+d]?.length);if(a===action)assert.equal(atlas.animations[a+'_'+d].length,15);frameRefs+=atlas.animations[a+'_'+d].length;}const ch=store.createCharacter(randomUUID(),account,'Test'+m.raceId+m.classId,'male',newProgress(),m.id);assert(ch);assert.equal(ch.modelId,m.id);assert.equal(ch.classId,m.classId);assert.equal(store.createCharacter(randomUUID(),account,'Wrong'+m.raceId+m.classId,'female',newProgress(),m.id),null);}
let exactFrames=0;for(const m of catalog){const p=proof.models.find((p:any)=>p.id===m.id),dir='assets/characters/'+m.id,atlas=JSON.parse(readFileSync(dir+'/'+m.id+'.json','utf8')),png=readPng(dir+'/'+m.id+'.png');assert(png.width<=2048&&png.height<=2048);for(const[name,expected]of Object.entries(p.frameHashes)as[string,string][]){const f=atlas.frames[name],im=createImage(160,160);blit(im,crop(png,f.frame.x,f.frame.y,f.frame.w,f.frame.h),f.spriteSourceSize.x,f.spriteSourceSize.y);assert.equal(createHash('sha256').update(im.data).digest('hex'),expected,'Trim làm thay pixel '+name);exactFrames++;}}
assert.equal(store.characters(account).length,25);store.close();writeFileSync(base+'/check.json',JSON.stringify({models:25,races:5,classes:5,originalAttackFrames:15,frameRefs,exactRgbaRoundtripFrames:exactFrames,genderValidation:true,modelPersistence:true,gptFrames:0},null,2));console.log('PASS:25 PixelLab models,5 races×5 classes;15-frame attacks;'+exactFrames+' exact RGBA roundtrips;new identity save/load;gender mismatch rejected. DB test in memory only.');
