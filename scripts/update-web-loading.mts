if(!html.includes('var decodedTotal =')){html=html.replace('var total = +res.headers.get("X-Decoded-Length") || +res.headers.get("Content-Length") || 0;','var decodedTotal = +res.headers.get("X-Decoded-Length") || +res.headers.get("Content-Length") || 0;\n            var total = +res.headers.get("Content-Length") || decodedTotal;').replace('var f = files[url] = { got: 0, total: total };','var f = files[url] = { got: 0, total: total, decoded: 0 };').replace('f.got += r.value.length;','f.decoded += r.value.length;\n                  f.got = decodedTotal > 0 ? Math.min(f.total, f.decoded / decodedTotal *f.total) : f.decoded;');}
