for(const f of files){if(!existsSync(f))continue;let html=readFileSync(f,'utf8').replace(/\r\n/g,'\n');html=html.replace('var total = +res.headers.get("X-Decoded-Length") || +res.headers.get("Content-Length") || 0;\n            var f = files[url] = { got: 0, total: total };','var decodedTotal = +res.headers.get("X-Decoded-Length") || +res.headers.get("Content-Length") || 0;\n            var total = +res.headers.get("Content-Length") || decodedTotal;\n            var f = files[url] = { got: 0, total: total, decoded: 0 };').replace('f.got += r.value.length;','f.decoded += r.value.length;\n                  f.got = decodedTotal > 0 ? Math.min(f.total, f.decoded / decodedTotal * f.total) : f.decoded;');
