import{existsSync,mkdirSync,readFileSync,readdirSync,copyFileSync,writeFileSync,renameSync,statSync}from'node:fs';import{resolve,join,relative,dirname}from'node:path';
const mode=process.argv[2];if(!['desktop','mobile'].includes(mode))throw Error('Cần desktop hoặc mobile');const src=resolve('.havenlord-stage/web-pixellab-release/'+mode),dst=resolve('apps/server/data/webgl'+(mode==='mobile'?'/m':'')),html=readFileSync(join(src,'index.html'),'utf8');
const refs=[...html.matchAll(/["'](Build\/[^"']+)["']/g)].map(m=>m[1]!).filter(f=>/\.(gz|br|js)$/.test(f));if(new Set(refs).size!==4)throw Error('HTML thiếu 4 gói runtime: '+JSON.stringify(refs));for(const f of refs)if(!existsSync(join(src,f)))throw Error('Thiếu gói '+f);
mkdirSync(dst,{recursive:true});for(const f of new Set(refs)){const target=join(dst,f);mkdirSync(dirname(target),{recursive:true});copyFileSync(join(src,f),target);}
function copyExtra(folder:string){const from=join(src,folder);if(!existsSync(from))return;for(const e of readdirSync(from,{withFileTypes:true})){const rel=folder+'/'+e.name;if(e.isDirectory())copyExtra(rel);else{mkdirSync(dirname(join(dst,rel)),{recursive:true});copyFileSync(join(src,rel),join(dst,rel));}}}
for(const name of['StreamingAssets','TemplateData'])copyExtra(name);for(const f of['decoded-sizes.json','compression-check.json'])if(existsSync(join(src,f)))copyFileSync(join(src,f),join(dst,f));
const release={mode,version:html.match(/productVersion:\s*"([^"]+)"/)?.[1],models:25,races:5,classes:5,art:'PixelLab original',gptFrames:0,files:[...new Set(refs)].map(f=>({file:f,bytes:statSync(join(src,f)).size})),publishedAt:new Date().toISOString()};writeFileSync(join(dst,'pixellab-release.json'),JSON.stringify(release,null,2));
// File gói được phát đủ trước; chỉ thay trang vào cuối, giữ gói cũ cho lượt tải đang dở.
const tmp=join(dst,'index.html.pixellab-next');writeFileSync(tmp,html);renameSync(tmp,join(dst,'index.html'));console.log(JSON.stringify({mode,version:release.version,downloadMB:Math.round(release.files.reduce((n,f)=>n+f.bytes,0)/1048576),url:'https://admin.tail024813.ts.net/game/play/'+(mode==='mobile'?'m/':'')}));
