import{mkdirSync,writeFileSync}from'node:fs';import{resolve}from'node:path';import{brotliCompressSync}from'node:zlib';import{createServer}from'node:http';import assert from'node:assert/strict';
const dir=resolve('.havenlord-stage/mobile-brotli-test');mkdirSync(dir+'/m/Build',{recursive:true});const body=Buffer.from('Haven Lord PixelLab mobile '.repeat(100));writeFileSync(dir+'/m/Build/proof.data.br',brotliCompressSync(body));writeFileSync(dir+'/m/decoded-sizes.json',JSON.stringify({'Build/proof.data.br':body.length}));process.env.HAVENLORD_PLAY_DIR=dir;
const{sendPlay}=await import('../apps/server/src/play.ts');const server=createServer((req,res)=>{if(!sendPlay(req.url!,req.url!,res,req))res.writeHead(404).end();});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const port=(server.address()as any).port;
try{const url='http://127.0.0.1:'+port+'/play/m/Build/proof.data.br',r=await fetch(url);assert.equal(r.status,200);assert.equal(r.headers.get('content-encoding'),'br');assert.equal(r.headers.get('content-type'),'application/octet-stream');assert.equal(Number(r.headers.get('x-decoded-length')),body.length);assert.deepEqual(Buffer.from(await r.arrayBuffer()),body);const h=await fetch(url,{method:'HEAD'});assert.equal(h.status,200);assert.equal(h.headers.get('content-encoding'),'br');assert.equal((await h.arrayBuffer()).byteLength,0);console.log('PASS mobile Brotli HTTP: correct encoding, decoded length, HEAD and exact payload.');}finally{server.close();}
