/** Một mẫu đồ Kiếm sĩ mới từ đúng NPC tham chiếu; không sửa NPC/game nguồn. */
import{readFileSync,writeFileSync,mkdirSync,existsSync}from'node:fs';import{join}from'node:path';import{createHash}from'node:crypto';
import{loadEnv}from'../packages/asset-pipeline/src/env.js';import{PixelLabMcp}from'../packages/asset-pipeline/src/pixellab/mcp.js';import{waitImages}from'../packages/asset-pipeline/src/pixellab/jobs.js';import{writePng}from'../packages/asset-pipeline/src/image/rgba.js';
const out='packages/asset-pipeline/sources/layered-character/starter-redesign-20261103/sword-male-pilot-covered',ref='packages/asset-pipeline/sources/layered-character/starter-redesign-20261103/sword-male-pilot/sword-male-S.png';mkdirSync(out,{recursive:true});
const description='Change ONLY the small exposed skin patches on both arms into dark navy cloth sleeves reaching the brown gloves, so no arm skin is visible. Keep the exact same swordsman outfit, steel shoulder guards and chest plate, leather straps, trousers, boots, body width, 73px height, pose, head, face, hair and original crisp pixel style. No other changes; no weapons.';
if(description.length>500)throw Error('Prompt quá dài');
const input=readFileSync(ref),args={description,image_base64:input.toString('base64'),width:80,height:80,no_background:true,seed:73171};
writeFileSync(join(out,'request.json'),JSON.stringify({...args,image_base64:'<'+ref+'>',referenceSha256:createHash('sha256').update(input).digest('hex'),previewOnly:true,artApproved:false,note:'NPC head retained ONLY in full visual design reference; never overlay another head or export this as a body layer. Head removal required before any runtime avatar composition. Attack paused; no animations requested.'},null,2));
const m=new PixelLabMcp(loadEnv(process.cwd()).PIXELLAB_TOKENS!.split(',')[0]!.trim());let jobId:string;
if(existsSync(join(out,'receipt.json')))jobId=JSON.parse(readFileSync(join(out,'receipt.json'),'utf8')).jobId;else{const before=await m.call('get_balance'),receipt=await m.call('edit_image_pixen',args),id=receipt.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/)?.[0];if(!id)throw Error(receipt);jobId=id;writeFileSync(join(out,'receipt.json'),JSON.stringify({jobId,balanceBefore:before,receipt},null,2));console.log('QUEUED '+jobId+'; one standing outfit design, 1 generation.');}
if(!existsSync(join(out,'complete.json'))){const[im]=await waitImages(m,jobId,1,{w:80,h:80});writePng(join(out,'sword-male-S.png'),im!);writeFileSync(join(out,'complete.json'),JSON.stringify({jobId,frames:1,balanceAfter:await m.call('get_balance')},null,2));}console.log('COMPLETE outfit pilot only; no attack, rotation or game build.');
