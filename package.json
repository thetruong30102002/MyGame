{
  "name": "haven-lord",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "server": "npm run dev -w @havenlord/server",
    "test": "npm test -w @havenlord/sim && npm test -w @havenlord/asset-pipeline",
    "assets:character": "npm run character -w @havenlord/asset-pipeline --",
    "assets:catalog": "npm run catalog -w @havenlord/asset-pipeline --",
    "assets:anchors": "npm run anchors -w @havenlord/asset-pipeline --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "assets:pixler": "npm run pixler -w @havenlord/asset-pipeline --",
    "assets:pixellab": "npm run pixellab -w @havenlord/asset-pipeline --",
    "assets:map": "npm run map -w @havenlord/asset-pipeline",
    "assets:vfx": "npm run vfx -w @havenlord/asset-pipeline",
    "assets:ui": "npm run ui -w @havenlord/asset-pipeline",
    "assets:world": "npm run world -w @havenlord/asset-pipeline",
    "assets:skill-icons": "npm run skill-icons -w @havenlord/asset-pipeline"
  }
}
