    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "daisyui": "^4.12.24",
    "esbuild": "^0.28.2",
    "sweetalert2": "^11.14.5",
    "tailwindcss": "^3.4.17",
